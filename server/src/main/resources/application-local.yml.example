# 本地开发配置示例：复制为 application-local.yml 后按需修改（该文件已被 .gitignore 忽略）。
# 启动：./mvnw spring-boot:run -Dspring-boot.run.profiles=local
spring:
  datasource:
    url: jdbc:mysql://127.0.0.1:3306/supervise?useUnicode=true&characterEncoding=utf8&connectionTimeZone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
    username: root
    password: ""

supervise:
  site-name: 会议任务督办系统（本地）
  frontend-base-url: http://localhost:5173
  scan:
    # 本地调试建议关闭启动补跑，避免每次重启都触发当天扫描
    startup-catchup-enabled: false
  dingtalk:
    # TODO: 上线前由 IT 补齐，留空即自动降级
    corp-id: ""
    agent-id: ""
    app-key: ""
    app-secret: ""
