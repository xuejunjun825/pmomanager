# 生产环境变量示例：复制为 /etc/supervise/supervise.env（chmod 600），由 systemd 注入。
# 不要把真实凭证提交到仓库。

# 服务
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod
JAVA_OPTS=-Xms256m -Xmx512m -Duser.timezone=Asia/Shanghai

# 数据库（库需预先创建：CREATE DATABASE supervise CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci;）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=supervise
DB_USER=supervise
DB_PASSWORD=__CHANGE_ME__

# 前端站点（钉钉免登回调后回跳）
FRONTEND_BASE_URL=https://supervise.example.internal

# 钉钉开放平台 —— TODO: 上线前由 IT 补齐，四项缺一即自动降级为站内通知
DINGTALK_CORP_ID=
DINGTALK_AGENT_ID=
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=

# 启动补跑（仅补当天）
SUPERVISE_SCAN_STARTUP_CATCHUP_ENABLED=true
