# /etc/systemd/system/supervise.service
[Unit]
Description=Supervise (meeting task supervision) backend
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=simple
User=supervise
Group=supervise
WorkingDirectory=/opt/supervise
EnvironmentFile=/etc/supervise/supervise.env
Environment=JAVA_HOME=/usr/lib/jvm/java-17-openjdk
ExecStart=/usr/bin/java $JAVA_OPTS -jar /opt/supervise/supervise.jar
SuccessExitStatus=143
Restart=on-failure
RestartSec=5
# 时区与编码
Environment=TZ=Asia/Shanghai
Environment=LANG=C.UTF-8

# 基础加固
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/supervise/logs

[Install]
WantedBy=multi-user.target
